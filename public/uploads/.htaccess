# Folder unggahan: file di sini hanya disajikan sebagai file statis,
# tidak pernah dieksekusi sebagai skrip.
Options -Indexes -ExecCGI

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .phar .php5 .php7 .php8 .pht
RemoveType .php .phtml .phar .php5 .php7 .php8 .pht

<FilesMatch "\.(php\d?|phtml|phar|pht|cgi|pl|py|sh|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
