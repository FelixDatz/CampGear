# Dipakai bila seluruh project diunggah ke document root (mis. htdocs di InfinityFree).
# Hanya folder public/ yang boleh diakses dari web; folder lain ditolak.

Options -Indexes

# File tersembunyi (.htaccess, .gitignore, dll.) tidak boleh diunduh.
# FilesMatch berlaku juga di subfolder, berbeda dengan RewriteRule yang tidak diwariskan
# ke folder yang punya .htaccess dengan RewriteEngine sendiri (mis. public/).
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Tolak akses langsung ke folder internal dan file tersembunyi (.git, .env, dll.)
    RewriteRule ^(app|config|database|storage|docs|tests)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]

    # Teruskan semua request lain ke folder public/
    RewriteCond %{REQUEST_URI} !(^|/)public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
